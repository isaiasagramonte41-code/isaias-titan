const express = require('express');
const path = require('path');
const app = express();

app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ limit: '10mb', extended: true }));

// Apuntando correctamente a la raíz del proyecto para los archivos estáticos
app.use(express.static(path.join(__dirname, '../')));

const dbKeys = {
    "mi_llave_maestra_secreta_123": { tipo: "dueño", limiteRestante: 999999 },
    "key_hermano_01": { tipo: "familiar", limiteRestante: 50 }, 
    "key_primo_02": { tipo: "familiar", limiteRestante: 30 }    
};

app.post('/v1/chat', async (req, res) => {
    const { apiKey, mensaje, imagenBase64 } = req.body;

    if (!apiKey || !dbKeys[apiKey]) {
        return res.status(401).json({ error: "API Key inválida o no registrada en tu compañía." });
    }

    const usuario = dbKeys[apiKey];

    if (usuario.tipo !== "dueño") {
        if (usuario.limiteRestante <= 0) {
            return res.status(429).json({ error: "Has superado tu límite diario asignado por el creador." });
        }
        usuario.limiteRestante -= 1;
    }

    try {
        const miClavePrivada = process.env.CUSTOM_API_KEY;

        if (!miClavePrivada) {
            return res.status(500).json({ error: "Falta configurar la CUSTOM_API_KEY en las variables de entorno de Render." });
        }

        let contents = [];
        let parts = [];

        if (mensaje) {
            parts.push({ text: mensaje });
        }

        if (imagenBase64) {
            const base64Clean = imagenBase64.replace(/^data:image\/[a-zA-Z]+;base64,/, "");
            parts.push({
                inline_data: {
                    mime_type: "image/jpeg",
                    data: base64Clean
                }
            });
        }

        if (parts.length === 0) {
            parts.push({ text: "Hola" });
        }

        contents.push({ role: "user", parts: parts });

        const geminiResponse = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${miClavePrivada}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contents: contents })
        });

        const data = await geminiResponse.json();

        if (!geminiResponse.ok) {
            throw new Error(data.error?.message || "Error al comunicarse con la API de Google Gemini.");
        }

        const respuestaIA = data.candidates?.[0]?.content?.parts?.[0]?.text || "No se pudo obtener una respuesta de la IA.";

        res.json({ 
            exito: true, 
            respuesta: respuestaIA,
            limiteActual: usuario.limiteRestante 
        });

    } catch (error) {
        console.error("Error en /v1/chat:", error);
        res.status(500).json({ error: "Error interno procesando la solicitud con la IA: " + error.message });
    }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`Tu servidor multimedia y de IA está corriendo en el puerto ${PORT}`);
});